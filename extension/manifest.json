{
  "manifest_version": 3,
  "name": "MultiChat Agent",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Native Messaging bridge for dedicated web chats.",
  "permissions": ["nativeMessaging", "storage", "unlimitedStorage", "tabs", "alarms", "scripting"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "MultiChat Agent settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
