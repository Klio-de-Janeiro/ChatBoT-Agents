{
  "name": "multichat-agent-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc --noEmit && node scripts/build.mjs",
    "test": "npm run build && node --import tsx --test tests/*.test.ts && node tests/live-dom.mjs && node tests/browser.mjs",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node tests/browser.mjs",
    "inspect:providers": "node scripts/inspect-providers.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src tests scripts *.json *.html *.css *.md",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src tests scripts *.json *.html *.css *.md"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "prettier": "^3.10.1",
    "selfsigned": "^5.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
